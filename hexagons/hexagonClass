from itertools import chain
class Hexagon:
    def __init__(self, n):
        self.n = n
        self.rings = self._create_rings()
        self.edges = self._create_edges()
        self.faces = self._create_faces()

    def _create_rings(self):
        """Build the per-ring edge lists (previously the global variable `c`)."""
        rings = []
        for j in range(self.n):
            temp = []
            for i in range(j * (2 * self.n), j * (2 * self.n) + 2 * self.n - 1):
                temp.append((i, i + 1))
            temp.append((j * (2 * self.n) + 2 * self.n - 1, j * (2 * self.n)))
            rings.append(temp)
        return rings

    def _create_edges(self):
        c = self.rings
        edges = list(chain.from_iterable(c))

        for j in range(1):
            for i in range(self.n):
                edges.append((c[j][2 * i][0], c[(j + 1) % self.n][2 * i][0]))

        for j in range(1, self.n):
            for i in range(self.n):
                edges.append((c[j][2 * i][1], c[(j + 1) % self.n][2 * i][0]))

        return edges

    def _create_faces(self):
        c = self.rings
        faces = []

        for j in range(1):
            for i in range(self.n):
                faces.append([
                    (c[j][2 * i][0],                        c[j][2 * i][1]),
                    (c[j][2 * i][1],                        c[j][(2 * i + 1) % (2 * self.n)][1]),
                    (c[j][(2 * i + 1) % (2 * self.n)][1],  c[(j + 1) % self.n][(2 * i + 1) % (2 * self.n)][1]),
                    (c[(j + 1) % self.n][(2 * i + 1) % (2 * self.n)][1], c[(j + 1) % self.n][2 * i][1]),
                    (c[(j + 1) % self.n][2 * i][1],         c[(j + 1) % self.n][2 * i][0]),
                    (c[(j + 1) % self.n][2 * i][0],         c[j][2 * i][0]),
                ])

        for j in range(1, self.n):
            for i in range(self.n):
                faces.append([
                    (c[j][2 * i + 1][0],                    c[j][2 * i + 1][1]),
                    (c[j][2 * i + 1][1],                    c[j][(2 * i + 2) % (2 * self.n)][1]),
                    (c[j][(2 * i + 2) % (2 * self.n)][1],  c[(j + 1) % self.n][(2 * i + 1) % (2 * self.n)][1]),
                    (c[(j + 1) % self.n][(2 * i + 1) % (2 * self.n)][1], c[(j + 1) % self.n][2 * i][1]),
                    (c[(j + 1) % self.n][2 * i][1],         c[(j + 1) % self.n][2 * i][0]),
                    (c[(j + 1) % self.n][2 * i][0],         c[j][2 * i + 1][0]),
                ])

        return faces
